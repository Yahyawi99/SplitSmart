{
  "name": "split-smart",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint",
    "db:migrate": "pnpm approve-builds && pnpm prisma migrate dev",
    "db:seed": "tsx --env-file=.env src/database/run-seed.ts",
    "db:reset": "pnpm prisma migrate reset --force && pnpm db:seed",
    "test": "jest --runInBand tests/unit",
    "test:integration": "jest --runInBand tests/integration",
    "postinstall": "prisma skills sync || exit 0",
    "contract:emit": "prisma contract emit"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@better-auth/infra": "^0.4.11",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/orm-postgres": "8.0.0-rc.12",
    "axios": "^1.21.1",
    "better-auth": "^1.7.6",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.3.0",
    "dotenv": "^18.0.4",
    "lucide-react": "^1.47.0",
    "next": "16.3.4",
    "next-themes": "^0.4.6",
    "nodemailer": "^10.0.12",
    "pg": "^8.23.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "0.0.1",
    "shadcn": "^4.21.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@jest/globals": "30.5.2",
    "@prisma/cli-engine": "0.6.1",
    "@prisma/client": "^7.10.0",
    "@tailwindcss/postcss": "^4",
    "@types/jest": "^30.0.0",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "jest": "^30.5.2",
    "prisma": "7.10.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  },
  "packageManager": "pnpm@12.4.2"
}